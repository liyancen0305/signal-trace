# Local development example only. Change the password in both values together.
SIGNAL_TRACE_POSTGRES_PASSWORD=signal_trace_local_only
SIGNAL_TRACE_RETRIEVAL_DATABASE_URL=postgresql://signal_trace:signal_trace_local_only@127.0.0.1:5432/signal_trace
SIGNAL_TRACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIGNAL_TRACE_EMBEDDING_CACHE_DIR=.cache/embeddings
SIGNAL_TRACE_RETRIEVAL_MIN_SCORE=0.55
