{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-trace:ground_truth:1.0",
  "title": "ground_truth",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "affected_service": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "SEV-1",
        "SEV-2",
        "SEV-3"
      ]
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "incident_id",
    "root_cause",
    "affected_service",
    "severity",
    "deployment_id",
    "evidence_ids",
    "rationale"
  ],
  "additionalProperties": false
}
