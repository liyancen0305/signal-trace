{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-trace:service:1.0",
  "title": "service",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "application",
        "database"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "service_id",
    "description",
    "kind",
    "owner"
  ],
  "additionalProperties": false
}
