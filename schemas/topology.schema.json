{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-trace:topology:1.0",
  "title": "topology",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "target",
          "protocol"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "edges"
  ],
  "additionalProperties": false
}
