{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-trace:log:1.0",
  "title": "log",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "log_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "INFO",
        "ERROR"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "exception_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    }
  },
  "required": [
    "schema_version",
    "log_id",
    "timestamp",
    "service_id",
    "level",
    "version",
    "trace_id",
    "message",
    "exception_type",
    "http_status"
  ],
  "additionalProperties": false
}
